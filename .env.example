# ==============================================================================
# AI CLUB - Environment Configuration Template
# Copy this file to .env.local (frontend) and .env (backend) as needed.
# NEVER commit sensitive API keys or service credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite requires VITE_ prefix for browser exposure)
# ------------------------------------------------------------------------------
VITE_APP_NAME="AI CLUB"
VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Server-only, never expose to browser)
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=5000
HOST="0.0.0.0"
API_VERSION="v1"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Supabase Server-side (Authoritative access)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-backend-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Logging & Monitoring
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Intelligence (Optional external LLM synthesis; deterministic fallback active if omitted)
GEMINI_API_KEY="your-gemini-api-key"
